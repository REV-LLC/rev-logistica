FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --workspace apps/web --include-workspace-root=false --include=dev --no-audit --no-fund
COPY apps/web apps/web
ENV NEXT_PUBLIC_API_BASE_URL=https://attendance-test-api-staging.up.railway.app NEXT_PUBLIC_ATTENDANCE_TEST=true NEXT_PUBLIC_AUTH_BYPASS=false NEXT_PUBLIC_AUTH_BYPASS_LOCAL=false NEXT_PUBLIC_LOCAL_AUTH_BYPASS=false NEXT_PUBLIC_DEPLOYMENT_ENV=staging NEXT_PUBLIC_IMAGE_BASE_URLS=https://attendance-test-api-staging.up.railway.app NEXT_TELEMETRY_DISABLED=1
RUN npm --workspace apps/web run build
ENV NODE_ENV=production PORT=3000
CMD ["sh", "-c", "npm --workspace apps/web run start -- --hostname 0.0.0.0 --port ${PORT:-3000}"]
