generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICE
  DRIVER
  OPERATOR
}

enum WarehouseType {
  OWN
  ALLY
}

enum SkuControlType {
  BULK
  SERIAL
}

enum ChargeType {
  DAY
  HOUR
}

enum AssetKind {
  STANDARD
  MOTOR
}

enum AssetMotorConfiguration {
  NONE
  FIXED
  INTERCHANGEABLE
}

enum EmployeeRole {
  DRIVER
  HEAVY_MACHINERY_OPERATOR
  MACHINIST
  OFFICE
  MANAGER
  OPERATIONS_MANAGER
  MECHANIC
  WAREHOUSE_KEEPER
  OTHER
}

enum DocumentType {
  DELIVERY
  PICKUP
  RECEIPT
  REMISSION
  RETURN
  ADJUSTMENT
  CUTOVER
  PROVIDER_RECEIPT
  PROVIDER_PICKUP
}

enum DocumentStatus {
  IN_PROGRESS
  DRAFT
  CONFIRMED
  FAILED
  VOID
}

enum DocumentItemBillingStatus {
  OPEN
  CUT
  CLOSED
}

enum CustomerIdentityDocumentType {
  NIT
  CC
}

enum FailureResponsibility {
  CUSTOMER
  COMPANY
  FORCE_MAJEURE
}

enum MovementType {
  OUT
  TRANSIT
  IN
  ADJUST
  ON_SITE
}

enum TaskStatus {
  OPEN
  DOING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskReminderUnit {
  MINUTES
  HOURS
  DAYS
  WEEKS
  MONTHS
}

enum SyncOperationStatus {
  PROCESSING
  COMPLETED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  ACCEPTED
  DELIVERED
  READ
  SENT
  FAILED
}

enum InventorySnapshotStatus {
  STAGED
  POSTED
}

enum InventorySnapshotSourceType {
  OWN_WAREHOUSE
  OWN_WORKSITE
  SUPPLIER
}

enum InventorySnapshotOwnershipType {
  OWN
  SUPPLIER
}

enum InventorySnapshotDestinationType {
  WAREHOUSE
  WORKSITE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  documentsCreated              Document[]              @relation("CreatedBy")
  ledgerCreated                 StockLedger[]           @relation("LedgerCreatedBy")
  tasksCreated                  Task[]                  @relation("TaskCreatedBy")
  tasksAssigned                 Task[]                  @relation("TaskAssignedTo")
  mobilityGuidesCreated         MobilityGuide[]         @relation("MobilityGuideCreatedBy")
  providerMobilityGuidesCreated ProviderMobilityGuide[] @relation("ProviderMobilityGuideCreatedBy")
  employee                      Employee?
  notificationRecipients        NotificationRecipient[]
  maintenanceReadings           AssetHourReading[]      @relation("MaintenanceReadingRecordedBy")
  vehicleMaintenanceReadings    VehicleHourReading[]    @relation("VehicleMaintenanceReadingRecordedBy")
  maintenanceCompletions        MaintenanceCompletion[] @relation("MaintenanceCompletedBy")
  notificationDeliveries        NotificationDelivery[]
  assetsDeleted                 Asset[]                 @relation("AssetDeletedBy")
  appSettingChanges             AppSettingAudit[]       @relation("AppSettingUpdatedBy")
  worksiteFuelReceipts          WorksiteFuelReceipt[]   @relation("WorksiteFuelReceiptCreatedBy")
  assetFuelings                 AssetFueling[]          @relation("AssetFuelingCreatedBy")
  vehicleFuelings               VehicleFueling[]        @relation("VehicleFuelingCreatedBy")
  syncOperations                SyncOperation[]
}

model SyncOperation {
  id             String              @id @default(uuid())
  idempotencyKey String
  operation      String
  status         SyncOperationStatus @default(PROCESSING)
  response       Json?
  createdBy      String
  createdAt      DateTime            @default(now())
  completedAt    DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@unique([createdBy, idempotencyKey])
  @@index([createdAt])
}

model AppSetting {
  key         String   @id
  value       Json
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditEntries AppSettingAudit[]

  @@index([category])
}

model AppSettingAudit {
  id              String   @id @default(uuid())
  settingKey      String
  oldValue        Json?
  newValue        Json
  updatedByUserId String
  createdAt       DateTime @default(now())

  setting   AppSetting @relation(fields: [settingKey], references: [key], onDelete: Cascade)
  updatedBy User       @relation("AppSettingUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([settingKey, createdAt(sort: Desc)])
  @@index([updatedByUserId])
}

model Customer {
  id                    String                        @id @default(uuid())
  name                  String
  identityDocumentType  CustomerIdentityDocumentType?
  nitOrId               String?
  phone                 String?
  email                 String?
  documentsEmail        String?
  documentsPhone        String?
  contactDirectory      Json?
  updateToken           String?                       @unique
  updateTokenExpiresAt  DateTime?
  contactUpdatedAt      DateTime?
  contactUpdatedBy      String?
  billingAddress        String?
  billingPhone          String?
  billingAlternatePhone String?
  active                Boolean                       @default(true)
  createdAt             DateTime                      @default(now())

  customerWorksites CustomerWorksite[]

  @@unique([identityDocumentType, nitOrId])
}

model Worksite {
  id             String   @id @default(uuid())
  externalCode   String?  @unique
  name           String
  address        String?
  contactName    String?
  phone          String?
  alternatePhone String?
  email          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  customerWorksites    CustomerWorksite[]
  worksiteFuelReceipts WorksiteFuelReceipt[]
  assetFuelings        AssetFueling[]

  @@map("Project")
}

model CustomerWorksite {
  id         String   @id @default(uuid())
  customerId String
  worksiteId String
  alias      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  worksite Worksite @relation(fields: [worksiteId], references: [id])

  documents                Document[]
  ledger                   StockLedger[]
  inventorySnapshotEntries InventorySnapshotEntry[]

  @@unique([customerId, worksiteId])
}

model Warehouse {
  id             String        @id @default(uuid())
  name           String
  type           WarehouseType
  ownerCompanyId String
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())

  assetsOwned               Asset[]                  @relation("OwnerWarehouse")
  assetsCurrent             Asset[]                  @relation("CurrentWarehouse")
  ledger                    StockLedger[]
  ledgerOwned               StockLedger[]            @relation("LedgerOwnerWarehouse")
  documents                 Document[]               @relation("DocumentWarehouse")
  providerPickupDocuments   Document[]               @relation("ProviderPickupSourceWarehouse")
  ownerCompany              Owner                    @relation(fields: [ownerCompanyId], references: [id])
  internalCounters          AssetInternalCounter[]
  inventorySnapshotEntries  InventorySnapshotEntry[]
  legacyWarehouseReferences LegacyWarehouse[]
  providerMobilityGuides    ProviderMobilityGuide[]
  providerSkuPrices         ProviderSkuPrice[]
  providerRemissionFiles    FileObject[]             @relation("ProviderRemissionWarehouse")
}

model LegacyWarehouse {
  code                   String   @id
  branchCode             String
  name                   String
  alternateCode          String?
  occupancyEnabled       Boolean
  sourceOwnFlag          Boolean
  inventoryCode          String?
  costCenterCode         String?
  active                 Boolean  @default(true)
  sourceCreatedAt        String?
  sourceCreatedBy        String?
  sourceUpdatedAt        String?
  sourceUpdatedBy        String?
  operationalWarehouseId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  operationalWarehouse Warehouse? @relation(fields: [operationalWarehouseId], references: [id], onDelete: SetNull)

  @@index([operationalWarehouseId])
  @@index([name])
}

model AssetFamily {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  controlType SkuControlType
  createdAt   DateTime       @default(now())

  skus                   Sku[]
  subfamilies            AssetSubfamily[]
  componentRules         AssetFamilyComponent[] @relation("ComponentRuleParent")
  usedAsComponentInRules AssetFamilyComponent[] @relation("ComponentRuleComponent")
}

model AssetFamilyComponent {
  id                     String   @id @default(uuid())
  parentAssetFamilyId    String
  componentAssetFamilyId String
  required               Boolean  @default(false)
  minimumQuantity        Int      @default(0)
  maximumQuantity        Int?
  sortOrder              Int      @default(0)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  parentAssetFamily    AssetFamily @relation("ComponentRuleParent", fields: [parentAssetFamilyId], references: [id], onDelete: Cascade)
  componentAssetFamily AssetFamily @relation("ComponentRuleComponent", fields: [componentAssetFamilyId], references: [id], onDelete: Cascade)

  @@unique([parentAssetFamilyId, componentAssetFamilyId])
  @@index([componentAssetFamilyId])
  @@index([parentAssetFamilyId, active, sortOrder])
}

model AssetSubfamily {
  id            String   @id @default(uuid())
  assetFamilyId String
  code          String
  name          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assetFamily      AssetFamily            @relation(fields: [assetFamilyId], references: [id])
  skus             Sku[]
  internalCounters AssetInternalCounter[]

  @@unique([assetFamilyId, code])
  @@unique([assetFamilyId, name])
}

model Sku {
  id                   String     @id @default(uuid())
  name                 String
  imageUrl             String?
  imageFileObjectId    String?
  assetFamilyId        String
  assetSubfamilyId     String?
  price                Decimal?
  subrentalPrice       Decimal?
  replacementValue     Decimal?
  chargeType           ChargeType @default(DAY)
  minimumChargeHours   Decimal?
  size                 String?
  lengthMeters         Decimal?   @db.Decimal(10, 2)
  closedLengthMeters   Decimal?   @db.Decimal(10, 2)
  extendedLengthMeters Decimal?   @db.Decimal(10, 2)
  areaM2               Decimal?
  unitWeight           Decimal?
  active               Boolean    @default(true)
  createdAt            DateTime   @default(now())

  assets               Asset[]
  documentItems        DocumentItem[]
  ledger               StockLedger[]
  imageFileObject      FileObject?           @relation("SkuImage", fields: [imageFileObjectId], references: [id])
  assetFamily          AssetFamily           @relation(fields: [assetFamilyId], references: [id])
  assetSubfamily       AssetSubfamily?       @relation(fields: [assetSubfamilyId], references: [id])
  providerPrices       ProviderSkuPrice[]
  providerReceiptItems ProviderReceiptItem[]
  providerPickupItems  ProviderPickupItem[]

  @@unique([assetFamilyId, name])
  @@index([assetSubfamilyId])
}

model ProviderSkuPrice {
  id                  String   @id @default(uuid())
  providerWarehouseId String
  skuId               String
  price               Decimal
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  providerWarehouse Warehouse @relation(fields: [providerWarehouseId], references: [id], onDelete: Cascade)
  sku               Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([providerWarehouseId, skuId])
  @@index([skuId])
}

model CatalogOption {
  id        String   @id @default(uuid())
  groupKey  String
  value     String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupKey, value])
  @@index([groupKey])
}

model Asset {
  id                 String                  @id @default(uuid())
  skuId              String
  publicCode         String                  @unique
  serialOrEngine     String?                 @unique
  registrationNumber String?                 @unique
  description        String?
  brand              String?
  model              String?
  year               Int?
  fuel               String?
  imageFileObjectId  String?
  internalNumber     Int
  weight             Decimal?
  hourMeter          Decimal                 @default(0) @db.Decimal(12, 2)
  warehouseOwnerId   String
  warehouseCurrentId String?
  active             Boolean                 @default(true)
  deletedAt          DateTime?
  deletedByUserId    String?
  deletionReason     String?
  kind               AssetKind               @default(STANDARD)
  motorConfiguration AssetMotorConfiguration @default(NONE)
  assignedMotorId    String?                 @unique
  createdAt          DateTime                @default(now())

  sku              Sku         @relation(fields: [skuId], references: [id])
  warehouseOwner   Warehouse   @relation("OwnerWarehouse", fields: [warehouseOwnerId], references: [id])
  warehouseCurrent Warehouse?  @relation("CurrentWarehouse", fields: [warehouseCurrentId], references: [id])
  imageFileObject  FileObject? @relation("AssetImage", fields: [imageFileObjectId], references: [id])
  assignedMotor    Asset?      @relation("MixerAssignedMotor", fields: [assignedMotorId], references: [id], onDelete: SetNull)
  assignedToMixer  Asset?      @relation("MixerAssignedMotor")
  deletedBy        User?       @relation("AssetDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  documentItems         DocumentItem[]
  ledger                StockLedger[]
  taskAssets            TaskAsset[]
  mobilityGuides        MobilityGuide[]
  hourReadings          AssetHourReading[]
  maintenancePlans      MaintenancePlan[]
  providerReceiptItems  ProviderReceiptItem[]
  providerPickupItems   ProviderPickupItem[]
  assetFuelings         AssetFueling[]
  documentItemsAsParent DocumentItem[]        @relation("DocumentItemComponentParentAsset")

  @@index([skuId])
  @@index([registrationNumber])
  @@index([deletedAt])
  @@index([deletedByUserId])
}

model ProviderMobilityGuide {
  id               String   @id @default(uuid())
  providerId       String
  fileObjectId     String   @unique
  machineReference String
  name             String
  issuedAt         DateTime
  expiresAt        DateTime
  createdByUserId  String
  createdAt        DateTime @default(now())

  provider   Warehouse  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  fileObject FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("ProviderMobilityGuideCreatedBy", fields: [createdByUserId], references: [id])

  @@index([providerId, issuedAt])
  @@index([issuedAt])
  @@index([expiresAt])
}

model MobilityGuide {
  id              String   @id @default(uuid())
  assetId         String
  fileObjectId    String   @unique
  name            String
  issuedAt        DateTime
  expiresAt       DateTime
  createdByUserId String
  createdAt       DateTime @default(now())

  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileObject FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("MobilityGuideCreatedBy", fields: [createdByUserId], references: [id])

  @@index([assetId, issuedAt])
  @@index([issuedAt])
  @@index([expiresAt])
}

model AssetHourReading {
  id                   String   @id @default(uuid())
  assetId              String
  hours                Decimal  @db.Decimal(12, 2)
  recordedAt           DateTime @default(now())
  note                 String?
  evidenceFileObjectId String?
  recordedByUserId     String
  createdAt            DateTime @default(now())

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  recordedBy User  @relation("MaintenanceReadingRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([assetId, hours(sort: Desc)])
  @@index([recordedByUserId])
  @@index([evidenceFileObjectId])
}

model MaintenancePlan {
  id        String   @id @default(uuid())
  assetId   String?
  vehicleId String?
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset   Asset?            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vehicle Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items   MaintenanceItem[]

  @@index([assetId, active])
  @@index([vehicleId, active])
}

model MaintenanceItem {
  id            String    @id @default(uuid())
  planId        String
  name          String
  instructions  String?
  intervalHours Decimal?  @db.Decimal(12, 2)
  warningHours  Decimal?  @db.Decimal(12, 2)
  baselineHours Decimal?  @db.Decimal(12, 2)
  intervalDays  Int?
  warningDays   Int?
  baselineDate  DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan        MaintenancePlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  completions MaintenanceCompletion[]

  @@index([planId, active])
}

model NotificationTopic {
  id              String    @id @default(uuid())
  entityType      String
  entityId        String
  eventType       String
  active          Boolean   @default(true)
  titleTemplate   String?
  messageTemplate String?
  dueAt           DateTime?
  warningDays     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipients NotificationRecipient[]
  deliveries NotificationDelivery[]

  @@unique([entityType, entityId, eventType])
  @@index([entityType, entityId, active])
  @@index([active, dueAt])
}

model NotificationRecipient {
  id              String  @id @default(uuid())
  topicId         String
  userId          String
  emailEnabled    Boolean @default(false)
  smsEnabled      Boolean @default(false)
  whatsappEnabled Boolean @default(true)

  topic NotificationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([userId, topicId])
}

model MaintenanceCompletion {
  id                String   @id @default(uuid())
  itemId            String
  completedAtHours  Decimal? @db.Decimal(12, 2)
  completedAt       DateTime @default(now())
  notes             String?
  completedByUserId String
  createdAt         DateTime @default(now())

  item        MaintenanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  completedBy User            @relation("MaintenanceCompletedBy", fields: [completedByUserId], references: [id])

  @@index([itemId, completedAtHours(sort: Desc)])
  @@index([completedByUserId])
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  topicId           String
  userId            String
  occurrenceKey     String
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?                    @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  error             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  topic NotificationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId, occurrenceKey, channel])
  @@index([userId, status])
}

model Task {
  id                    String            @id @default(uuid())
  title                 String
  description           String?
  bulkItemName          String?
  status                TaskStatus        @default(OPEN)
  priority              TaskPriority      @default(MEDIUM)
  dueDate               DateTime?
  reminderIntervalValue Int?
  reminderIntervalUnit  TaskReminderUnit?
  createdByUserId       String
  assignedToUserId      String?
  assignedToEmployeeId  String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  createdBy          User        @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  assignedTo         User?       @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  assignedToEmployee Employee?   @relation("TaskAssignedToEmployee", fields: [assignedToEmployeeId], references: [id])
  assets             TaskAsset[]

  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([assignedToEmployeeId])
  @@index([status])
  @@index([priority])
}

model TaskAsset {
  id        String   @id @default(uuid())
  taskId    String
  assetId   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([taskId, assetId])
  @@index([assetId])
}

model Document {
  id                  String         @id @default(uuid())
  shareToken          String         @unique @default(uuid())
  type                DocumentType
  status              DocumentStatus @default(DRAFT)
  consecutive         String?        @unique
  customerWorksiteId  String?
  warehouseId         String?
  providerWarehouseId String?
  createdBy           String
  docDate             DateTime       @default(now())
  notes               String?
  recipientPhone      String?
  recipientPhones     String[]       @default([])

  // Failed fields
  failedReason         String?
  failedResponsibility FailureResponsibility?
  failedFeeApplicable  Boolean                @default(false)

  // Retry chain
  retryOfDocumentId String?
  retryOfDocument   Document?  @relation("RetryChain", fields: [retryOfDocumentId], references: [id])
  retries           Document[] @relation("RetryChain")

  providerSourceDocumentId String?
  providerSourceDocument   Document?  @relation("ProviderReceiptSource", fields: [providerSourceDocumentId], references: [id])
  providerReceipts         Document[] @relation("ProviderReceiptSource")

  // Void fields
  voidReason String?
  voidedBy   String?
  voidedAt   DateTime?

  createdAt              DateTime  @default(now())
  officeModifiedAt       DateTime?
  officeModifiedBy       String?
  customerDraftEmailedAt DateTime?
  customerFinalEmailedAt DateTime?

  customerWorksite  CustomerWorksite? @relation(fields: [customerWorksiteId], references: [id])
  warehouse         Warehouse?        @relation("DocumentWarehouse", fields: [warehouseId], references: [id])
  providerWarehouse Warehouse?        @relation("ProviderPickupSourceWarehouse", fields: [providerWarehouseId], references: [id])
  creator           User              @relation("CreatedBy", fields: [createdBy], references: [id])

  items                      DocumentItem[]
  ledger                     StockLedger[]
  files                      FileObject[]
  messageDeliveries          DocumentMessageDelivery[]
  emailDeliveries            DocumentEmailDelivery[]
  providerReceiptItems       ProviderReceiptItem[]     @relation("ProviderReceiptDocument")
  providerReceiptSourceItems ProviderReceiptItem[]     @relation("ProviderReceiptSourceDocument")
  providerPickupItems        ProviderPickupItem[]

  @@index([providerSourceDocumentId])
  @@index([providerWarehouseId])
}

model ProviderPickupItem {
  id         String   @id @default(uuid())
  documentId String
  skuId      String?
  assetId    String?
  quantity   Decimal
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sku      Sku?     @relation(fields: [skuId], references: [id])
  asset    Asset?   @relation(fields: [assetId], references: [id])

  @@index([documentId])
  @@index([skuId])
  @@index([assetId])
}

model ProviderReceiptItem {
  id                String   @id @default(uuid())
  receiptDocumentId String
  sourceDocumentId  String
  sourceLedgerId    String
  skuId             String?
  assetId           String?
  quantity          Decimal
  createdAt         DateTime @default(now())

  receiptDocument Document    @relation("ProviderReceiptDocument", fields: [receiptDocumentId], references: [id], onDelete: Cascade)
  sourceDocument  Document    @relation("ProviderReceiptSourceDocument", fields: [sourceDocumentId], references: [id])
  sourceLedger    StockLedger @relation(fields: [sourceLedgerId], references: [id])
  sku             Sku?        @relation(fields: [skuId], references: [id])
  asset           Asset?      @relation(fields: [assetId], references: [id])

  @@index([receiptDocumentId])
  @@index([sourceDocumentId])
  @@index([sourceLedgerId])
  @@index([skuId])
  @@index([assetId])
}

model DocumentEmailDelivery {
  id              String                     @id @default(uuid())
  documentId      String
  kind            String
  email           String
  subject         String
  attachmentNames Json
  status          NotificationDeliveryStatus @default(PENDING)
  sentAt          DateTime?
  error           String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, kind])
  @@index([status, createdAt(sort: Desc)])
  @@index([documentId, createdAt(sort: Desc)])
}

model DocumentMessageDelivery {
  id                String                     @id @default(uuid())
  documentId        String
  kind              String
  channel           NotificationChannel
  phone             String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?                    @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  error             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, kind, channel, phone])
  @@index([documentId, status])
}

model DocumentItem {
  id         String @id @default(uuid())
  documentId String

  // BULK
  skuId        String?
  quantity     Decimal?
  requestedTag String?

  // SERIAL
  assetId String?

  // Optional grouping: this line accompanied a serialized parent asset.
  componentParentAssetId String?

  condition          String?
  conditionNote      String?
  damageCostEstimate Decimal?
  billingCutoffDate  DateTime?
  returnedAt         DateTime?
  billingStatus      DocumentItemBillingStatus @default(OPEN)
  billingNote        String?
  billingUpdatedAt   DateTime?
  billingUpdatedBy   String?

  createdAt DateTime @default(now())

  document             Document @relation(fields: [documentId], references: [id])
  sku                  Sku?     @relation(fields: [skuId], references: [id])
  asset                Asset?   @relation(fields: [assetId], references: [id])
  componentParentAsset Asset?   @relation("DocumentItemComponentParentAsset", fields: [componentParentAssetId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([skuId])
  @@index([assetId])
  @@index([componentParentAssetId])
  @@index([requestedTag])
}

model StockLedger {
  id String @id @default(uuid())

  // Identificador del item (uno de los dos)
  skuId   String?
  assetId String?

  warehouseId        String?
  ownerWarehouseId   String
  customerWorksiteId String?
  movementType       MovementType
  quantity           Decimal

  refDocumentId   String?
  refDocumentType DocumentType?

  createdAt DateTime @default(now())
  createdBy String

  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id])
  ownerWarehouse   Warehouse         @relation("LedgerOwnerWarehouse", fields: [ownerWarehouseId], references: [id])
  customerWorksite CustomerWorksite? @relation(fields: [customerWorksiteId], references: [id])
  document         Document?         @relation(fields: [refDocumentId], references: [id])

  sku   Sku?   @relation(fields: [skuId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])

  creator              User                  @relation("LedgerCreatedBy", fields: [createdBy], references: [id])
  providerReceiptItems ProviderReceiptItem[]

  @@index([refDocumentId])
  @@index([skuId])
  @@index([assetId])
  @@index([warehouseId])
  @@index([ownerWarehouseId])
}

model InventorySnapshot {
  id           String                  @id @default(uuid())
  sourceKey    String                  @unique
  snapshotDate DateTime
  status       InventorySnapshotStatus @default(STAGED)
  metadata     Json?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  articles          InventorySnapshotArticle[]
  warehouseMappings InventorySnapshotWarehouseMapping[]
  entries           InventorySnapshotEntry[]
}

model InventorySnapshotArticle {
  id                         String   @id @default(uuid())
  snapshotId                 String
  articleCode                String
  articleName                String
  groupCode                  String
  groupName                  String
  subgroupCode               String?
  subgroupName               String?
  appearsInWarehouse         Boolean
  appearsOnSite              Boolean
  appearsInSupplierInventory Boolean
  unitWeight                 Decimal?
  suggestedControlType       String
  classificationStatus       String
  observations               String?
  createdAt                  DateTime @default(now())

  snapshot InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, articleCode])
  @@index([articleCode])
}

model InventorySnapshotWarehouseMapping {
  id                         String   @id @default(uuid())
  snapshotId                 String
  legacyWarehouseCode        String
  mappedWarehouseName        String?
  warehouseType              String?
  ownerName                  String?
  appearsInOwnWarehouse      Boolean
  appearsInOwnOnSite         Boolean
  appearsInSupplierInventory Boolean
  sourceRows                 Int
  mappingStatus              String
  observations               String?
  createdAt                  DateTime @default(now())

  snapshot InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, legacyWarehouseCode])
  @@index([legacyWarehouseCode])
}

model InventorySnapshotEntry {
  id                     String                           @id @default(uuid())
  snapshotId             String
  sourceType             InventorySnapshotSourceType
  sourceRow              Int
  ownershipType          InventorySnapshotOwnershipType
  destinationType        InventorySnapshotDestinationType
  customerWorksiteId     String?
  warehouseId            String?
  customerDocument       String?
  customerName           String?
  worksiteExternalCode   String?
  worksiteName           String?
  costCenterCode         String?
  costCenterName         String?
  legacyWarehouseCode    String
  groupCode              String
  groupName              String
  subgroupCode           String?
  subgroupName           String?
  articleCode            String
  articleName            String
  initialBalance         Decimal
  inventoryIn            Decimal
  rentalIn               Decimal
  inventoryOut           Decimal
  rentalOut              Decimal
  finalBalance           Decimal
  unitWeight             Decimal?
  totalWeight            Decimal?
  relationStatus         String
  warehouseMappingStatus String
  importStatus           String
  observations           String?
  createdAt              DateTime                         @default(now())

  snapshot         InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  customerWorksite CustomerWorksite? @relation(fields: [customerWorksiteId], references: [id], onDelete: SetNull)
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, sourceType, destinationType, sourceRow])
  @@index([articleCode])
  @@index([customerWorksiteId])
  @@index([warehouseId])
  @@index([legacyWarehouseCode])
  @@index([sourceType, finalBalance])
}

model AssetInternalCounter {
  id               String   @id @default(uuid())
  ownerWarehouseId String
  assetSubfamilyId String
  nextNumber       Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerWarehouse Warehouse      @relation(fields: [ownerWarehouseId], references: [id])
  assetSubfamily AssetSubfamily @relation(fields: [assetSubfamilyId], references: [id])

  @@unique([ownerWarehouseId, assetSubfamilyId])
}

model Owner {
  id        String   @id @default(uuid())
  name      String
  nitOrId   String?
  phone     String?
  email     String?
  logoUrl   String?
  logoKey   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  warehouses Warehouse[]
}

model Employee {
  id         String       @id @default(uuid())
  name       String
  lastName   String       @default("")
  role       EmployeeRole
  phone      String?
  email      String?
  documentId String?
  userId     String?      @unique
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  vehicles        EmployeeVehicle[]
  user            User?             @relation(fields: [userId], references: [id])
  tasksAssigned   Task[]            @relation("TaskAssignedToEmployee")
  assetFuelings   AssetFueling[]    @relation("AssetFuelingOperator")
  vehicleFuelings VehicleFueling[]  @relation("VehicleFuelingDriver")
}

model Vehicle {
  id                    String    @id @default(uuid())
  plate                 String    @unique
  brand                 String?
  model                 String?
  year                  Int?
  type                  String?
  capacity              String?
  soatVigencia          DateTime?
  tecnomecanicaVigencia DateTime?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())

  drivers          EmployeeVehicle[]
  maintenancePlans MaintenancePlan[]
  hourReadings     VehicleHourReading[]
  fuelings         VehicleFueling[]
}

model WorksiteFuelReceipt {
  id           String   @id @default(uuid())
  worksiteId   String
  receivedAt   DateTime
  quantityCans Decimal  @db.Decimal(12, 2)
  notes        String?
  createdBy    String
  createdAt    DateTime @default(now())

  worksite Worksite @relation(fields: [worksiteId], references: [id])
  creator  User     @relation("WorksiteFuelReceiptCreatedBy", fields: [createdBy], references: [id])

  @@index([worksiteId, receivedAt])
}

model AssetFueling {
  id                 String   @id @default(uuid())
  worksiteId         String
  assetId            String
  fueledAt           DateTime
  quantityCans       Decimal  @db.Decimal(12, 2)
  hourMeter          Decimal  @db.Decimal(14, 2)
  operatorEmployeeId String?
  notes              String?
  createdBy          String
  createdAt          DateTime @default(now())

  worksite Worksite  @relation(fields: [worksiteId], references: [id])
  asset    Asset     @relation(fields: [assetId], references: [id])
  operator Employee? @relation("AssetFuelingOperator", fields: [operatorEmployeeId], references: [id])
  creator  User      @relation("AssetFuelingCreatedBy", fields: [createdBy], references: [id])

  @@index([worksiteId, fueledAt])
  @@index([assetId, fueledAt])
}

model VehicleFueling {
  id               String   @id @default(uuid())
  vehicleId        String
  fueledAt         DateTime
  quantityGallons  Decimal  @db.Decimal(12, 3)
  odometerKm       Decimal  @db.Decimal(14, 1)
  fullTank         Boolean  @default(false)
  totalCost        Decimal? @db.Decimal(14, 2)
  supplier         String?
  invoiceNumber    String?
  driverEmployeeId String?
  notes            String?
  createdBy        String
  createdAt        DateTime @default(now())

  vehicle Vehicle   @relation(fields: [vehicleId], references: [id])
  driver  Employee? @relation("VehicleFuelingDriver", fields: [driverEmployeeId], references: [id])
  creator User      @relation("VehicleFuelingCreatedBy", fields: [createdBy], references: [id])

  @@index([vehicleId, fueledAt])
}

model VehicleHourReading {
  id               String   @id @default(uuid())
  vehicleId        String
  hours            Decimal  @db.Decimal(12, 2)
  recordedAt       DateTime @default(now())
  note             String?
  recordedByUserId String
  createdAt        DateTime @default(now())

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("VehicleMaintenanceReadingRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([vehicleId, hours(sort: Desc)])
  @@index([recordedByUserId])
}

model EmployeeVehicle {
  employeeId String
  vehicleId  String
  assignedAt DateTime @default(now())
  active     Boolean  @default(true)

  employee Employee @relation(fields: [employeeId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])

  @@id([employeeId, vehicleId])
  @@index([vehicleId])
}

model FileObject {
  id                  String    @id @default(uuid())
  documentId          String?
  entityType          String?
  entityId            String?
  fileType            String // SIGNATURE | PHOTO | business document category
  category            String?
  displayName         String?
  originalName        String?
  storageKey          String
  objectKey           String?
  storageProvider     String    @default("R2")
  mimeType            String?
  sizeBytes           Int?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  createdBy           String
  providerWarehouseId String?

  document              Document?              @relation(fields: [documentId], references: [id])
  providerWarehouse     Warehouse?             @relation("ProviderRemissionWarehouse", fields: [providerWarehouseId], references: [id], onDelete: SetNull)
  skuImages             Sku[]                  @relation("SkuImage")
  assetImages           Asset[]                @relation("AssetImage")
  mobilityGuide         MobilityGuide?
  providerMobilityGuide ProviderMobilityGuide?

  @@index([documentId])
  @@index([entityType, entityId])
  @@index([fileType])
  @@index([category])
  @@index([providerWarehouseId, category, createdAt(sort: Desc)])
  @@index([expiresAt])
}
