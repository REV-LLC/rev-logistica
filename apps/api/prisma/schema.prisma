generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICE
  DRIVER
}

enum WarehouseType {
  OWN
  ALLY
}

enum SkuControlType {
  BULK
  SERIAL
}

enum EmployeeRole {
  DRIVER
  HEAVY_MACHINERY_OPERATOR
  MACHINIST
  OFFICE
  MANAGER
  OPERATIONS_MANAGER
  MECHANIC
  WAREHOUSE_KEEPER
  OTHER
}

enum DocumentType {
  DELIVERY
  PICKUP
  RECEIPT
  REMISSION
  RETURN
  ADJUSTMENT
  CUTOVER
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  FAILED
  VOID
}

enum FailureResponsibility {
  CUSTOMER
  COMPANY
  FORCE_MAJEURE
}

enum MovementType {
  OUT
  TRANSIT
  IN
  ADJUST
  ON_SITE
}

enum TaskStatus {
  OPEN
  DOING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  passwordHash String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  documentsCreated Document[] @relation("CreatedBy")
  ledgerCreated    StockLedger[] @relation("LedgerCreatedBy")
  tasksCreated     Task[] @relation("TaskCreatedBy")
  tasksAssigned    Task[] @relation("TaskAssignedTo")
  employee         Employee?
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  nitOrId   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  customerWorksites CustomerWorksite[]
}

model Worksite {
  id         String   @id @default(uuid())
  name       String
  address    String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  customerWorksites CustomerWorksite[]

  @@map("Project")
}

model CustomerWorksite {
  id         String   @id @default(uuid())
  customerId String
  worksiteId String
  alias      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  worksite Worksite @relation(fields: [worksiteId], references: [id])

  documents Document[]
  ledger    StockLedger[]

  @@unique([customerId, worksiteId])
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  type      WarehouseType
  ownerCompanyId String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assetsOwned   Asset[] @relation("OwnerWarehouse")
  assetsCurrent Asset[] @relation("CurrentWarehouse")
  ledger        StockLedger[]
  ledgerOwned   StockLedger[] @relation("LedgerOwnerWarehouse")
  documents     Document[]
  ownerCompany  Owner    @relation(fields: [ownerCompanyId], references: [id])
  internalCounters AssetInternalCounter[]
}

model AssetFamily {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  controlType SkuControlType
  createdAt DateTime @default(now())

  skus   Sku[]
  assets Asset[]
  internalCounters AssetInternalCounter[]
}

model Sku {
  id          String         @id @default(uuid())
  name        String
  category    String
  imageUrl    String?
  imageFileObjectId String?
  assetFamilyId String
  price       Decimal?
  subrentalPrice Decimal?
  areaM2      Decimal?
  unitWeight  Decimal?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())

  assets       Asset[]
  documentItems DocumentItem[]
  ledger       StockLedger[]
  imageFileObject FileObject? @relation("SkuImage", fields: [imageFileObjectId], references: [id])
  assetFamily AssetFamily @relation(fields: [assetFamilyId], references: [id])

  @@unique([assetFamilyId, name])
}

model Asset {
  id                String   @id @default(uuid())
  skuId             String
  publicCode        String   @unique
  serialOrEngine    String   @unique
  description       String?
  brand             String?
  model             String?
  year              Int?
  fuel              String?
  imageFileObjectId String?
  assetFamilyId     String
  internalNumber    Int
  weight            Decimal?
  warehouseOwnerId  String
  warehouseCurrentId String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  sku              Sku       @relation(fields: [skuId], references: [id])
  warehouseOwner   Warehouse @relation("OwnerWarehouse", fields: [warehouseOwnerId], references: [id])
  warehouseCurrent Warehouse? @relation("CurrentWarehouse", fields: [warehouseCurrentId], references: [id])
  imageFileObject  FileObject? @relation("AssetImage", fields: [imageFileObjectId], references: [id])
  assetFamily      AssetFamily @relation(fields: [assetFamilyId], references: [id])

  documentItems DocumentItem[]
  ledger        StockLedger[]
  taskAssets    TaskAsset[]

  @@index([assetFamilyId])
  @@unique([warehouseOwnerId, assetFamilyId, internalNumber])
}

model Task {
  id               String       @id @default(uuid())
  title            String
  description      String?
  bulkItemName     String?
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(MEDIUM)
  dueDate          DateTime?
  createdByUserId  String
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  createdBy  User  @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  assignedTo User? @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  assets     TaskAsset[]

  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([priority])
}

model TaskAsset {
  id        String   @id @default(uuid())
  taskId    String
  assetId   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([taskId, assetId])
  @@index([assetId])
}

model Document {
  id        String        @id @default(uuid())
  type      DocumentType
  status    DocumentStatus @default(DRAFT)
  consecutive String?      @unique
  customerWorksiteId String?
  warehouseId String?
  createdBy String
  docDate   DateTime      @default(now())
  notes     String?

  // Failed fields
  failedReason         String?
  failedResponsibility FailureResponsibility?
  failedFeeApplicable  Boolean @default(false)

  // Retry chain
  retryOfDocumentId String?
  retryOfDocument   Document? @relation("RetryChain", fields: [retryOfDocumentId], references: [id])
  retries           Document[] @relation("RetryChain")

  // Void fields
  voidReason String?
  voidedBy   String?
  voidedAt   DateTime?

  createdAt DateTime @default(now())

  customerWorksite CustomerWorksite? @relation(fields: [customerWorksiteId], references: [id])
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id])
  creator          User             @relation("CreatedBy", fields: [createdBy], references: [id])

  items     DocumentItem[]
  ledger    StockLedger[]
  files     FileObject[]
}

model DocumentItem {
  id         String   @id @default(uuid())
  documentId String

  // BULK
  skuId     String?
  quantity  Decimal?
  requestedTag String?

  // SERIAL
  assetId   String?

  condition          String?
  conditionNote      String?
  damageCostEstimate Decimal?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
  sku      Sku?     @relation(fields: [skuId], references: [id])
  asset    Asset?   @relation(fields: [assetId], references: [id])

  @@index([documentId])
  @@index([skuId])
  @@index([assetId])
  @@index([requestedTag])
}

model StockLedger {
  id        String      @id @default(uuid())

  // Identificador del item (uno de los dos)
  skuId     String?
  assetId   String?

  warehouseId String?
  ownerWarehouseId String
  customerWorksiteId String?
  movementType MovementType
  quantity    Decimal

  refDocumentId   String?
  refDocumentType DocumentType?

  createdAt DateTime @default(now())
  createdBy String

  warehouse         Warehouse?        @relation(fields: [warehouseId], references: [id])
  ownerWarehouse    Warehouse        @relation("LedgerOwnerWarehouse", fields: [ownerWarehouseId], references: [id])
  customerWorksite  CustomerWorksite? @relation(fields: [customerWorksiteId], references: [id])
  document          Document?         @relation(fields: [refDocumentId], references: [id])

  sku   Sku?   @relation(fields: [skuId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])

  creator User @relation("LedgerCreatedBy", fields: [createdBy], references: [id])

  @@index([refDocumentId])
  @@index([skuId])
  @@index([assetId])
  @@index([warehouseId])
  @@index([ownerWarehouseId])
}

model AssetInternalCounter {
  id               String   @id @default(uuid())
  ownerWarehouseId String
  assetFamilyId    String
  nextNumber       Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerWarehouse Warehouse @relation(fields: [ownerWarehouseId], references: [id])
  assetFamily    AssetFamily @relation(fields: [assetFamilyId], references: [id])

  @@unique([ownerWarehouseId, assetFamilyId])
}

model Owner {
  id        String   @id @default(uuid())
  name      String
  nitOrId   String?
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  warehouses Warehouse[]
}

model Employee {
  id         String       @id @default(uuid())
  name       String
  role       EmployeeRole
  phone      String?
  email      String?
  documentId String?
  userId     String?      @unique
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  vehicles EmployeeVehicle[]
  user     User?          @relation(fields: [userId], references: [id])
}

model Vehicle {
  id        String   @id @default(uuid())
  plate     String   @unique
  brand     String?
  model     String?
  type      String?
  capacity  String?
  soatVigencia DateTime?
  tecnomecanicaVigencia DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  drivers EmployeeVehicle[]
}

model EmployeeVehicle {
  employeeId String
  vehicleId  String
  assignedAt DateTime @default(now())
  active     Boolean  @default(true)

  employee Employee @relation(fields: [employeeId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])

  @@id([employeeId, vehicleId])
  @@index([vehicleId])
}

model FileObject {
  id        String   @id @default(uuid())
  documentId String
  fileType  String   // SIGNATURE | PHOTO
  storageKey String
  mimeType  String?
  createdAt DateTime @default(now())
  createdBy String

  document Document @relation(fields: [documentId], references: [id])
  skuImages   Sku[]   @relation("SkuImage")
  assetImages Asset[] @relation("AssetImage")
}
