DATABASE_URL=postgresql://rev:revpass@localhost:5432/rev_logistica
ALLOWED_ORIGINS=http://localhost:3001
JWT_SECRET=change-me
# Development only. Ignored when NODE_ENV=production.
AUTH_BYPASS_LOCAL=false
AUTH_BYPASS_USER_EMAIL=
# When the bypass is enabled, the API binds to 127.0.0.1 unless HOST is explicitly set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
GOOGLE_MAPS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=REV Logistica
# Optional notification channels. Alert emails are disabled; SMTP is reserved for customer documents.
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_TOKEN=
# Optional shared webhook for WhatsApp alerts and future document links.
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_TOKEN=
# Direct Meta WhatsApp Cloud API (preferred).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=rev_logistica_notification
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
WHATSAPP_API_VERSION=v25.0
# Public web origin used to build customer document links.
PUBLIC_WEB_URL=http://localhost:3101
VEHICLE_DOCUMENT_WARNING_DAYS=30
NOTIFICATION_AUTO_DISPATCH=true
NOTIFICATION_DISPATCH_INTERVAL_MINUTES=60
