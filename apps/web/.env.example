# API base URL for the Nest backend (leave empty to use same origin)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Development only. Ignored in production builds.
NEXT_PUBLIC_AUTH_BYPASS_LOCAL=false
# Explicit non-production deployment bypass. Both values are required.
NEXT_PUBLIC_DEPLOYMENT_ENV=
NEXT_PUBLIC_AUTH_BYPASS=false

# Public image origins/path prefixes, comma-separated. Must match API R2_PUBLIC_BASE_URL.
# Empty uses the current REV public bucket. Only public HTTPS sources belong here.
NEXT_PUBLIC_IMAGE_BASE_URLS=

# Native Traccar panel (public HTTPS URL without credentials, tokens or query parameters).
# Empty uses the REV tracking server. Rebuild the web app after changing this value.
NEXT_PUBLIC_TRACCAR_WEB_URL=https://traccar-production-260b.up.railway.app
