{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"production\" ]",
  "headers": [
    {
      "source": "/maps/rev-sites-v1.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://gps.revcontractorsllc.com"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
